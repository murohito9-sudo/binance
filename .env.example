# Salin menjadi .env lalu isi nilainya. Jangan commit .env.
# Semua nilai di bawah hanya contoh placeholder.

# --- Server ---
PORT=3000

# --- Database (MySQL 8) ---
DATABASE_URL=mysql://nalar:password@127.0.0.1:3306/nalarai

# --- Layanan AI & penyimpanan lampiran (Manus) ---
MANUS_API_URL=https://api.example.com
MANUS_API_KEY=ganti-dengan-kunci-layanan

# --- Login pemilik (Manus OAuth) ---
MANUS_OAUTH_PORTAL_URL=https://portal.example.com
MANUS_OAUTH_API_URL=https://api.example.com
MANUS_PROJECT_ID=ganti-dengan-app-id-proyek
MANUS_JWT_SECRET=ganti-dengan-string-acak-panjang
NALARAI_OWNER_EMAIL=pemilik@example.com

# --- Provider AI (opsional) ---
# Urutan prioritas; provider yang tidak dikonfigurasi otomatis dilewati.
AI_PROVIDER_ORDER=manus,openai-compatible
AI_REQUEST_TIMEOUT_MS=60000
# MANUS_MODEL=nama-model-manus
# AI_OPENAI_BASE_URL=https://api.openai.com
# AI_OPENAI_API_KEY=ganti-dengan-kunci-provider-kedua
# AI_OPENAI_MODEL=gpt-4o-mini

# --- Batas permintaan & log ---
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_BINANCE_PER_MINUTE=12
RATE_LIMIT_UPLOAD_PER_MINUTE=10
LOG_LEVEL=info

# --- Binance Spot baca-saja ---
# API key dengan izin "Enable Reading" saja, plus private key Ed25519 dalam format PEM.
# Baris PEM boleh ditulis dengan \n literal agar muat dalam satu baris .env.
BINANCE_API_KEY=ganti-dengan-api-key-read-only
BINANCE_ED25519_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nganti-dengan-kunci-ed25519\n-----END PRIVATE KEY-----
